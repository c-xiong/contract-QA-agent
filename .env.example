# Copy to .env and fill in. .env is gitignored.

# --- Model access ---------------------------------------------------------
# Read directly by app/config.py. The Anthropic SDK also reads this name.
ANTHROPIC_API_KEY=

# Gate for anything that spends money. Tests and eval runs use a deterministic
# stub unless this is 1. See .claude/rules/evals.md ("Cost").
CRA_LIVE_MODEL=0

# --- Overrides (all optional; defaults live in app/config.py) -------------
# CRA_MODEL_ID=claude-sonnet-5
# CRA_MODEL_TIMEOUT_S=60.0
# CRA_RETRIEVAL_TOP_K=5
# CRA_ANSWERABILITY_GATE=0
# CRA_DATA_DIR=data

# Active tool-routing path; v1 remains the historical comparison baseline.
CRA_AGENT_MODE=v2
CRA_RUNS_DIR=runs

# --- Langfuse (optional; project keys stay in your gitignored .env) ---------
# Fill both keys from Langfuse Project > Settings > API Keys.
# The application constructs OTLP authentication from these values.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Enable after both keys are configured. Export contains metadata only.
CRA_TELEMETRY_EXPORT=0
CRA_TELEMETRY_TIMEOUT_S=5
