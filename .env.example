# Copy to .env and fill in. .env is gitignored.

# --- Model access ---------------------------------------------------------
# Read directly by app/config.py. The Anthropic SDK also reads this name.
ANTHROPIC_API_KEY=

# Gate for anything that spends money. Tests and eval runs use a deterministic
# stub unless this is 1. See .claude/rules/evals.md ("Cost").
CRA_LIVE_MODEL=0

# --- Overrides (all optional; defaults live in app/config.py) -------------
# CRA_MODEL_ID=claude-sonnet-5
# CRA_MODEL_TIMEOUT_S=60.0
# CRA_RETRIEVAL_TOP_K=5
# CRA_DATA_DIR=data
