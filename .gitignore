# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment
.env
.env.local

# Corpus and derived artifacts. Never checked in: CUAD/ContractNLI are
# redistributable but large, and every one is reproducible from scripts/.
data/raw/
data/processed/
data/index/

# Eval and experiment run outputs. Reports that back a README claim are
# checked in deliberately, one at a time -- not swept in by a glob.
evals/runs/
experiments/runs/

# Design canvas build output (~2 MB, regenerated by the design skill's seeder from
# the .dc.html sources, which ARE checked in).
design/trace-inspector.html
design/_*.py
design/_*.html

# Private working documents. These are the author's own planning and study material,
# not part of the published project: the full specification, the decisions log, the
# review-question list, and the eval-methodology worksheet.
docs/SPEC.md
docs/decisions.md
docs/review-questions.md
docs/eval-methodology.md
docs/authoring-eval-tasks.md
.claude/
# Cites docs/SPEC.md by section throughout; SPEC.md is private, so this would dangle.
CLAUDE.md

# OS / editor
.DS_Store
*.swp
