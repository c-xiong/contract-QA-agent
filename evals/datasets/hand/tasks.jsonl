{"task_id": "lookup-001", "category": "single_document_fact_lookup", "question": "At least how long before the end of the term should they notice if they want to cancel the agreement?", "expected_behavior": "answer", "allowed_document_ids": ["doc-033"], "expected_document_ids": ["doc-033"], "expected_evidence": [{"document_id": "doc-033", "page_number": 9, "span_text": "This Agreement will automatically renew at the end of the Initial Term or a subsequent renewal term on a year to year basis (each, a \"Renewal Term\"), unless either Party notifies the other at least 30 days prior to the end of the Initial Term or then current Renewal Term, as applicable, of its intention not to renew this Agreement (a \"Termination Notice\").", "source": "cuad"}], "required_points": ["30 days"], "forbidden_claims": [], "dataset_version": "hand-v1"}
